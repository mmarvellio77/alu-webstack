#!/usr/bin/env bash
# Displays DNS record information about subdomains of a given domain
# Usage: ./0-world_wide_web <domain> [subdomain]

subdomain_info () {
	dig "$2.$1" | grep -A1 'ANSWER SECTION:' | tail -n 1 | \
		awk -v sub_d="$2" '{print "The subdomain " sub_d " is a " $4 " record and points to " $5}'
}

if [ -n "$2" ]
then
	subdomain_info "$1" "$2"
else
	for sub in www lb-01 web-01 web-02
	do
		subdomain_info "$1" "$sub"
	done
fi
